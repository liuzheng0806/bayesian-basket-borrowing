# Covariance Sigma
s33 <- sg^2 / (2*rho)
s13 <- ( a13 * (a22 + a33) - a12 * a23) * s33 / ( a12 * a21 + ( a11 + a33 )*( a22 + a33 ))
s23 <- ((a11 + a33) * s13 -a13 * s33 ) / a12
s12 <- ((a11*a22*a23+a13*a21*a22)*s13+(a11*a12*a23-a11*a13*a22)*s23)/((a11 + a22)*(a11 * a22 + a12 * a21))
s11 <- (a12 * s12 + a13 * s13) / a11
s22 <- -(a21 * s12 + a23 * s23) / a22
Sigma <- matrix(c(s11,s12,s12,s22),nr=2,byrow = T)
return(list(mean,Sigma))
}
