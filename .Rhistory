f_fun <- function(I){
return(I / ( 1 + I ) )
}
dev_f<-function(I){
return(1/(1+I)^2)
}
modelpara<-function(bt,rho,sg){
lda<- 50
mu <- 3.4246*10^(-3)
alpha <- 0.24
ga <- 0.4
#地方病平衡点
#R0 <- bt * lda / ( mu * ( alpha + mu + ga ))
Istar <- ( bt* lda - mu * ( alpha + mu + ga )) / (( alpha + mu + ga ) * ( bt + mu ))#注意Istar可以用R自带的数值方法解，适合更一般的f
Sstar <- lda / ( mu + ( bt * Istar ) / ( 1 + Istar ))
mean <- c( Sstar, Istar )
#f函数和导数
fI <- f_fun(Istar)
df <- dev_f(Istar)
#线性化模型的系数矩阵
q<-rho^4+(alpha+2*mu+ga+bt*fI-bt*Sstar*df)*rho^3+((alpha+mu+ga)*(mu+bt*fI)-mu*bt*Sstar*df)*rho^2
sg13<-(-bt*fI*Sstar*rho^2-(alpha+mu+ga)*bt*Sstar*fI*rho)*nu/(2*q)
j<-(2*(alpha+mu+ga)*mu*bt^2*Sstar^2*fI^2-mu*bt^3*Sstar^3*fI^2*df+(alpha+mu+ga)*bt^3*Sstar^2*fI^3)* rho^2 +((alpha+mu+ga)*(alpha+2*mu+ga)*mu*bt^2*Sstar^2*fI^2-(alpha+mu+ga)*mu*bt^3*Sstar^3*fI^2*df+(alpha+mu+ga)*mu*bt^3*Sstar^2*fI^3)*rho
p<-mu*bt^2*Sstar^2*df^2-(alpha+2*mu+ga)*bt^2*Sstar*fI*df-(2*alpha+3*mu+2*ga)*mu*bt*Sstar*df+(alpha+mu+ga)*bt^2*fI^2+(alpha+mu+ga)*(alpha+3*mu+ga)*bt*fI+(alpha+mu+ga)*(alpha+2*mu+ga)*mu
sg23<-(bt*Sstar*fI*rho^2+mu*bt*Sstar*fI*rho)*nu/(2*q)
sg12<-j*nu/(2*p*q)
sg22<-(bt*fI/(2*(alpha+mu+ga-bt*Sstar*df)*p) * j*nu/q) + ((bt*Sstar*fI)/(2*(alpha+mu+ga-bt*Sstar*df) )* (bt*Sstar*fI*rho^2+mu*bt*Sstar*fI*rho)*nu/q)
sg11<--(bt*Sstar*df/(2*(mu+bt*fI)*p) * j*nu/q) + ((bt*Sstar*fI)/(2*(mu+bt*fI) )* (bt*Sstar*fI*rho^2+(alpha+mu+ga)*bt*Sstar*fI*rho)*nu/q)
Sigma<-matrix(c(sg11,sg12,sg12,sg22),nr=2,byrow = T)
return(list(mean,Sigma))
}
modelpara(2.57*10^(-2),0.3,1.5e-3)
zt
